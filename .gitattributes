# Normalize line endings to LF in the repository.
# Git will convert to the native line ending on checkout.
* text=auto eol=lf

# Explicitly declare text files that should always use LF
*.ts        text eol=lf
*.html      text eol=lf
*.css       text eol=lf
*.json      text eol=lf
*.md        text eol=lf
*.js        text eol=lf
*.mjs       text eol=lf
*.xml       text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
*.txt       text eol=lf
*.editorconfig text eol=lf

# Binary files - do not touch line endings
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.webp      binary
*.svg       binary
*.woff      binary
*.woff2     binary
*.ttf       binary
*.eot       binary
*.otf       binary
*.exe       binary
*.pem       binary
*.key       binary
